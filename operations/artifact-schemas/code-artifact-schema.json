{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code Artifact",
  "type": "object",
  "required": ["artifact_type", "version", "metadata", "code"],
  "properties": {
    "artifact_type": {
      "type": "string",
      "enum": ["code"]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["created_at", "created_by", "task_id"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "enum": ["backend-coder", "mobile-coder", "web-coder"]
        },
        "task_id": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "enum": ["csharp", "kotlin", "typescript", "javascript"]
        },
        "platform": {
          "type": "string",
          "enum": ["backend", "mobile", "web"]
        }
      }
    },
    "code": {
      "type": "object",
      "required": ["files", "build_status"],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "language", "lines_of_code"],
            "properties": {
              "path": {"type": "string"},
              "language": {"type": "string"},
              "lines_of_code": {"type": "integer", "minimum": 0},
              "checksum": {"type": "string"}
            }
          }
        },
        "build_status": {
          "type": "string",
          "enum": ["success", "failure", "not_built"]
        },
        "build_output": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "version": {"type": "string"},
              "ecosystem": {"type": "string"}
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "unit_tests": {
          "type": "object",
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "passed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0}
          }
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage_report_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "linting_passed": {"type": "boolean"},
        "linting_errors": {"type": "integer", "minimum": 0},
        "linting_warnings": {"type": "integer", "minimum": 0},
        "code_smells": {"type": "integer", "minimum": 0},
        "technical_debt_minutes": {"type": "integer", "minimum": 0}
      }
    },
    "artifact_location": {
      "type": "string",
      "format": "uri",
      "description": "URL or path to the artifact storage location"
    }
  }
}
